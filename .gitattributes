# Auto-normalise les fins de ligne selon le système d'exploitation

# Fichiers texte - détecter automatiquement
* text=auto

# Documents texte
*.md text eol=lf
*.txt text eol=lf
*.csv text eol=lf
*.json text eol=lf

# Code source
*.py text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.html text eol=lf
*.css text eol=lf

# Configuration
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.ini text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Fichiers binaires
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.mov binary
*.mp4 binary
*.mp3 binary
*.zip binary
*.gz binary
